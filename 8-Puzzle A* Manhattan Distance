
# 8-Puzzle using A* Algorithm
# g(n) = Depth of node
# h(n) = Manhattan Distance
# f(n) = g(n) + h(n)

def heuristic(state, goal):
    distance = 0

    for i in range(9):
        tile = state[i]

        if tile != 0:
            goal_pos = goal.index(tile)

            row1, col1 = i // 3, i % 3
            row2, col2 = goal_pos // 3, goal_pos % 3

            distance += abs(row1 - row2) + abs(col1 - col2)

    return distance


def display(state):
    for i in range(0, 9, 3):
        print(state[i:i+3])
    print()


def get_neighbors(state):
    neighbors = []

    blank = state.index(0)
    row = blank // 3
    col = blank % 3

    moves = [(-1, 0), (1, 0), (0, -1), (0, 1)]

    for dr, dc in moves:
        new_row = row + dr
        new_col = col + dc

        if 0 <= new_row < 3 and 0 <= new_col < 3:
            new_blank = new_row * 3 + new_col

            new_state = list(state)
            new_state[blank], new_state[new_blank] = (
                new_state[new_blank], new_state[blank]
            )

            neighbors.append(tuple(new_state))

    return neighbors


def astar(start, goal):
    open_list = [(heuristic(start, goal), 0, start, [start])]
    best_g = {start: 0}

    while open_list:
        open_list.sort(key=lambda x: x[0])
        f, g, current, path = open_list.pop(0)

        if g != best_g.get(current):
            continue

        if current == goal:
            return path

        for neighbor in get_neighbors(current):
            new_g = g + 1

            if new_g < best_g.get(neighbor, float("inf")):
                best_g[neighbor] = new_g

                h = heuristic(neighbor, goal)
                new_f = new_g + h

                open_list.append(
                    (new_f, new_g, neighbor, path + [neighbor])
                )

    return None


# Main Program
start = (1, 2, 3,
         4, 0, 6,
         7, 5, 8)

goal = (1, 2, 3,
        4, 5, 6,
        7, 8, 0)

print("Initial State:")
display(start)

print("Goal State:")
display(goal)

solution = astar(start, goal)

if solution:
    print("Solution Found!")
    print("Number of moves:", len(solution) - 1)

    for i, state in enumerate(solution):
        print("Step", i)
        display(state)
else:
    print("No solution found.")
