# 8-Puzzle using Iterative Deepening Search (IDS)

def display(state):
    for i in range(0, 9, 3):
        print(state[i:i + 3])
    print()


# Generate possible moves
def get_moves(state):

    moves = []

    zero = state.index(0)

    row = zero // 3
    col = zero % 3

    # UP
    if row > 0:
        moves.append(zero - 3)

    # DOWN
    if row < 2:
        moves.append(zero + 3)

    # LEFT
    if col > 0:
        moves.append(zero - 1)

    # RIGHT
    if col < 2:
        moves.append(zero + 1)

    return moves


# Depth Limited Search
def dls(state, goal, limit, path, visited, level_states):

    current_depth = len(path) - 1

    # Store state at its depth
    if current_depth not in level_states:
        level_states[current_depth] = []

    level_states[current_depth].append(state)

    # Check goal
    if state == goal:
        return path

    # Stop if depth limit reached
    if limit == 0:
        return None

    visited.add(state)

    zero = state.index(0)

    # Generate successors
    for move in get_moves(state):

        new_state = list(state)

        # Swap blank with tile
        new_state[zero], new_state[move] = \
            new_state[move], new_state[zero]

        new_state = tuple(new_state)

        # Avoid repeated states
        if new_state not in visited:

            result = dls(
                new_state,
                goal,
                limit - 1,
                path + [new_state],
                visited,
                level_states
            )

            if result is not None:
                return result

    visited.remove(state)

    return None


# IDS
def ids(start, goal):

    depth = 0

    while True:

        print("\n================================")
        print("DEPTH LIMIT:", depth)
        print("================================")

        visited = set()
        level_states = {}

        solution = dls(
            start,
            goal,
            depth,
            [start],
            visited,
            level_states
        )

        # Print each level
        for level in sorted(level_states):

            print("\nDepth", level)

            for state in level_states[level]:
                display(state)

        # Check if goal found
        if solution is not None:

            print("GOAL FOUND AT DEPTH:", depth)

            return solution

        depth += 1


