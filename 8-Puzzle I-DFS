# Main Program
# --------------------------------

start = (
    1, 2, 3,
    4, 0, 6,
    7, 5, 8
)

goal = (
    1, 2, 3,
    4, 5, 6,
    7, 8, 0
)


print("INITIAL STATE:")
display(start)

print("GOAL STATE:")
display(goal)


solution = ids(start, goal)


# Final solution
print("\n========== FINAL SOLUTION ==========")

for i, state in enumerate(solution):

    print("\nStep", i)
    display(state)
